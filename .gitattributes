# Fichiers exécutés ou lus sous Linux (serveur, conteneurs) : fins de ligne Unix,
# même sur un poste Windows (core.autocrlf). Un script .sh en CRLF plante sous bash.
*.sh              text eol=lf
*.conf            text eol=lf
*.yml             text eol=lf
*.yaml            text eol=lf
*.sql             text eol=lf
*.prisma          text eol=lf
*.toml            text eol=lf
Dockerfile        text eol=lf
.dockerignore     text eol=lf
.env.example      text eol=lf
*.png             binary
