# HORUS — variables de production (~/horus/infra/.env sur le serveur, droits 600, JAMAIS commité).
# Générer les secrets :  python3 -c 'import secrets;print(secrets.token_urlsafe(32))'

HORUS_URL=https://horus.mairiederouffiac.fr
KEYCLOAK_ISSUER_URL=https://auth.mairiederouffiac.fr/realms/horus

# Base PostgreSQL dédiée
POSTGRES_PASSWORD=

# Secret du compte de service Keycloak « horus-admin » (le même est injecté dans le realm par creer-realm.sh)
HORUS_ADMIN_SECRET=

# Rapport mensuel IA (facultatif : sans clé, le bouton répond « non activé »)
ANTHROPIC_API_KEY=
